# Install dependencies
install:
    pnpm install

# Build: bundle workflows + compile handler (produces dist/)
build:
    pnpm run build

# Build the Lambda artifact directory consumed by `cdk deploy` (produces dist-lambda/)
build-lambda:
    pnpm run build:lambda

# Synthesize CloudFormation templates without contacting AWS
synth env="sa-demo":
    pnpm exec cdk synth TsLambdaWorker-{{ env }}

# Deploy via CDK. Defaults to the sa-demo environment.
deploy env="sa-demo":
    pnpm run build:lambda
    pnpm exec cdk deploy TsLambdaWorker-{{ env }} --require-approval never

# Bootstrap the CDK environment in the target account/region (run once per account/region)
bootstrap env="sa-demo":
    pnpm exec cdk bootstrap TsLambdaWorker-{{ env }}

# Invoke the handler locally against a running Temporal dev server
invoke:
    pnpm exec ts-node src/scripts/local-handler.ts events/invoke.json events/local-env.json

# Tail CloudWatch logs after a real deployment
logs stack="aspinks-ts-lambda-worker":
    aws logs tail \
        /aws/lambda/$(aws cloudformation describe-stack-resources \
            --stack-name {{ stack }} \
            --logical-resource-id WorkerFunction \
            --query 'StackResources[0].PhysicalResourceId' \
            --output text) \
        --follow

# Start a workflow against a local Temporal dev server (for testing)
start-workflow:
    pnpm exec ts-node src/client.ts
