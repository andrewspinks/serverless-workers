# Install dependencies
install:
    pnpm install

# Build: bundle workflows + compile handler (produces dist/)
build:
    pnpm run build

# Build the Lambda artifact directory consumed by `cdk deploy` (produces dist-lambda/)
build-lambda:
    pnpm run build:lambda

# Synthesize CloudFormation templates without contacting AWS
synth env="sa-demo":
    pnpm exec cdk synth TsLambdaWorker-{{ env }}

# Deploy to AWS. Omit build_id to auto-increment minor version (v1.1 → v1.2);
# pass an explicit version to use that instead: just deploy v2.0
deploy build_id="":
    ./scripts/deploy.sh {{ build_id }}

# Bootstrap the CDK environment in the target account/region (run once per account/region)
bootstrap env="sa-demo":
    pnpm exec cdk bootstrap TsLambdaWorker-{{ env }}

# Invoke the handler locally against a running Temporal dev server
invoke:
    pnpm exec ts-node src/scripts/local-handler.ts events/invoke.json events/local-env.json

# Tail CloudWatch logs after a real deployment
logs stack="aspinks-ts-lambda-worker":
    aws logs tail \
        /aws/lambda/$(aws cloudformation describe-stack-resources \
            --stack-name {{ stack }} \
            --logical-resource-id WorkerFunction \
            --query 'StackResources[0].PhysicalResourceId' \
            --output text) \
        --follow

# Start a workflow against a local Temporal dev server (for testing)
start-workflow:
    pnpm exec ts-node src/client.ts

# Print the `temporal worker deployment create-version` command for the deployed stack.
# Run this after `just deploy` to register the new Lambda version with Temporal Cloud.
register-version stack="aspinks-ts-lambda-worker":
    #!/usr/bin/env bash
    set -euo pipefail
    query() {
      aws cloudformation describe-stacks \
        --stack-name {{ stack }} \
        --profile SolutionsArchitecture/AWSAdministratorAccess \
        --region us-east-2 \
        --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue" \
        --output text
    }
    FUNCTION_VERSION_ARN=$(query WorkerFunctionVersionArn)
    ROLE_ARN=$(query TemporalCloudInvokeRoleArn)
    BUILD_ID=$(query BuildId)
    DEPLOY_NAME=$(query TemporalDeploymentName)
    EXTERNAL_ID=$(query AssumeRoleExternalId)
    echo ""
    echo "Run this to register the deployed version with Temporal Cloud:"
    echo ""
    echo "temporal worker deployment create-version \\"
    echo "  --deployment-name $DEPLOY_NAME \\"
    echo "  --build-id $BUILD_ID \\"
    echo "  --aws-lambda-function-arn $FUNCTION_VERSION_ARN \\"
    echo "  --aws-lambda-assume-role-arn $ROLE_ARN \\"
    echo "  --aws-lambda-assume-role-external-id $EXTERNAL_ID"
    echo ""
